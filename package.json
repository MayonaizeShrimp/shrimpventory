{
  "name": "shrimpventory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite --config configs/vite.config.ts --open",
    "dev": "vite --config configs/vite.config.ts",
    "build": "tsc -b && vite build --config configs/vite.config.ts",
    "preview": "vite preview --config configs/vite.config.ts",
    "typecheck": "tsc -b",
    "lint": "biome lint --config-path=configs .",
    "format": "biome format --config-path=configs --write .",
    "check": "biome check --config-path=configs .",
    "check:fix": "biome check --config-path=configs --write ."
  },
  "nx": {
    "name": "shrimpventory"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "nx": "^24.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
