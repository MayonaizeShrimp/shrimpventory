{
  "name": "shrimpventory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite --config configs/vite/vite.config.ts --open",
    "build": "tsc -b && vite build --config configs/vite/vite.config.ts",
    "preview": "vite preview --config configs/vite/vite.config.ts",
    "test": "vitest run --config configs/vitest/vitest.config.ts --coverage",
    "test:no-coverage": "vitest run --config configs/vitest/vitest.config.ts",
    "lint": "biome check --config-path=configs/biome --write .",
    "lint:no-fix": "biome check --config-path=configs/biome .",
    "prepare": "husky configs/husky"
  },
  "nx": {
    "name": "shrimpventory"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "9.1.7",
    "jsdom": "^31.0.1",
    "nx": "^24.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
